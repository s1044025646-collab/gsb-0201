{
  "name": "leslie-population-service",
  "version": "1.0.0",
  "description": "年龄结构种群投影与增长弹性分析后端（Leslie 模型，出生后普查）",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "leslie-cli": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "tsx watch src/server.ts",
    "cli": "node --experimental-sqlite --import tsx src/cli/index.ts",
    "test": "vitest run",
    "demo": "node --experimental-sqlite --import tsx scripts/demo.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
